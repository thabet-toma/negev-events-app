# ------------------------------------------------------------------
# Negev Events Platform — environment configuration
# Copy to .env and fill in real values. Never commit the real .env.
# ------------------------------------------------------------------

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# --- Security -----------------------------------------------------
# REQUIRED in production. Generate with:  openssl rand -hex 48
JWT_SECRET=
JWT_USER_TTL=90d
JWT_ADMIN_TTL=12h
BCRYPT_ROUNDS=10

# --- MySQL --------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=negev_events
DB_USER=negev
DB_PASSWORD=change-me-strong-password
DB_POOL_SIZE=10

# Used only by docker-compose to initialise the MySQL container
MYSQL_ROOT_PASSWORD=change-me-strong-root-password

# --- Bootstrap super admin (seeded once, on first run) -------------
ADMIN_PHONE=0500000000
ADMIN_PIN=9999
ADMIN_NAME=مدير عام المنصة

# --- Uploads ------------------------------------------------------
UPLOADS_DIR=
UPLOAD_MAX_MB=30

# --- CORS / rate limiting -----------------------------------------
# e.g. https://events.example.com,https://www.example.com   ("*" = any)
CORS_ORIGINS=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_MAX=20
